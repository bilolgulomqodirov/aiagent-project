# =====================================================================
# Telegram Shaxsiy AI Agent — Sozlamalar fayli
# =====================================================================

# 1. Telegram API ma'lumotlari
# my.telegram.org saytiga kiring -> API development tools -> yangi app yarating
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Telethon sessiya fayli nomi (masalan: my_userbot)
TELEGRAM_SESSION_NAME=my_agent_session

# 2. Google Gemini AI API
# https://aistudio.google.com/ saytidan bepul API kalit oling
GEMINI_API_KEY=AIzaSy...sizning_gemini_api_kalitingiz

# Tavsiya etilgan modellar: gemini-2.5-flash yoki gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 3. Vaqt va Rejalashtiruvchi sozlamalari
# Kunlik AI Digest yuboriladigan vaqt (24 soatlik formatda: SS:DD)
DIGEST_TIME=21:00
TIMEZONE=Asia/Tashkent

# 4. Modullar va Funksiyalarni boshqarish (1 = Yoqilgan, 0 = O'chirilgan)
ENABLE_MESSAGE_LOGGER=1
ENABLE_DELETED_MESSAGE_ALERT=1
ENABLE_NEW_CHAT_ALERT=1
ENABLE_URGENCY_ALERT=1
ENABLE_VOICE_TRANSCRIPTION=1
ENABLE_SPAM_FILTER=1

# Shoshilinchlikni filtrlash uchun asosiy kalit so'zlar (vergul bilan ajrating)
URGENCY_KEYWORDS=muhim,tezda,pul,tasdiqlang,kod,sms,shoshilinch,urgent,parol,to'lov,alert,bank

# 5. Saqlash joylari
DATABASE_PATH=./storage/agent.db
MEDIA_STORAGE_DIR=./storage/media
